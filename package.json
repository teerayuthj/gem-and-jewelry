{
  "name": "gold-gem-component",
  "version": "1.0.0",
  "description": "A comprehensive gold trading and price display component with multi-language support",
  "main": "dist/gold-gem-component.js",
  "scripts": {
    "build": "node build.js",
    "build:version": "node build.js --version",
    "build:saving2": "node build-saving2.js",
    "build:saving2:dev": "node build-saving2.js --dev",
    "dev": "npm run build && open dist/demo.html",
    "dev:saving2": "npm run build:saving2 && open saving-build.html",
    "watch": "nodemon -e css,js,json,html --ignore dist/ --exec 'npm run build'",
    "watch:saving2": "nodemon -e css,js --watch assets/ --ignore dist/ --exec 'npm run build:saving2'",
    "release": "npm run build && git add dist/ && git commit -m 'Build: Update component bundle' && git push",
    "tag": "npm version patch && git push origin master --tags"
  },
  "files": [
    "dist/",
    "assets/",
    "build.js",
    "README.md"
  ],
  "keywords": [
    "gold",
    "trading",
    "component",
    "javascript",
    "css",
    "responsive",
    "multi-language",
    "thai",
    "english",
    "cdn",
    "jsdelivr"
  ],
  "author": "Teerayuth T",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/teerayuthj/gem-and-jewelry.git"
  },
  "bugs": {
    "url": "https://github.com/teerayuthj/gem-and-jewelry/issues"
  },
  "homepage": "https://github.com/teerayuthj/gem-and-jewelry#readme",
  "devDependencies": {
    "esbuild": "^0.27.2",
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
